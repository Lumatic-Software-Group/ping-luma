# Never commit real secrets. On PaaS (Back4app, etc.), set variables in the dashboard — .env is not deployed from git.
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
BASE_URL=https://api.telegram.org/bot
# PROXY_URL=socks5://127.0.0.1:1080
PROXY_URL=
CONNECT_TIMEOUT=30
READ_TIMEOUT=30
WRITE_TIMEOUT=30

# Public HTTPS URL that hosts web/dashboard.html. Telegram requires HTTPS.
WEBAPP_URL=https://pingluma.app

# Iran-side reference
# The bot answers "would an Iranian VPN help this user?" by comparing the
# user's WebApp result against an Iran-side reference. Four independent
# sources can feed that reference; whichever ones are configured are merged.
#
# Order of authority (highest wins):
#   1. HTTP override   — an operator-controlled JSON endpoint
#   2. Crowdsource     — live WebRTC samples from real Iranian-routed users
#   3. OONI            — historical web_connectivity from Iranian volunteer probes
#   4. ASN classifier  — static structural inference from BGP routing
#
# If none are configured, the bot falls back to the static priors shipped in
# ping_luma/domain/messengers.py and clearly tells the user the advice is a hint.

# Source 1: HTTP override (optional, free path documented)
# Operator-controlled endpoint returning {"results": {<id>: {chat_ok,call_ok}}}.
# The recommended free setup: a trusted volunteer in Iran runs a self-hosted
# GitHub Actions runner that probes every 30 min and commits iran-ref.json to
# a public repo; the bot reads it via raw.githubusercontent.com. Walkthrough
# in volunteer-repo/README.md. Once set up, the URL looks like:
#   IRAN_REFERENCE_URL=https://raw.githubusercontent.com/YOUR_USER/pingluma-iran-ref/main/iran-ref.json
# IRAN_REFERENCE_TOKEN is unused for raw.githubusercontent.com on a public
# repo — leave it empty. Set IRAN_REFERENCE_TTL_S to about half your
# publisher cron interval (e.g. 1800 if the publisher runs every 30 min).
IRAN_REFERENCE_URL=
IRAN_REFERENCE_TOKEN=

# Cache TTL for the merged Iran-reference snapshot. Also drives the cadence
# of the background refresh loop. 21600 = 6h.
IRAN_REFERENCE_TTL_S=21600

# Source 2: ASN classifier (always on)
# Path to the JSON map produced by `python -m scripts.refresh_asn_map`.
# Ship the file with the deploy artifact and re-run the script weekly so the
# IP→ASN mapping stays fresh.
ASN_MAP_PATH=ping_luma/infrastructure/asn_map.json

# Source 3: OONI (historical, free)
# OONI's volunteer-run probes generate per-country web_connectivity
# measurements that we can aggregate per messenger host. No API key needed.
# Used as a chat-side cross-check only (OONI doesn't run WebRTC).
OONI_ENABLED=true
OONI_LOOKBACK_DAYS=7
OONI_TTL_S=86400
OONI_TIMEOUT_S=15
OONI_SUCCESS_THRESHOLD=0.7
OONI_BLOCKED_THRESHOLD=0.5
OONI_MIN_MEASUREMENTS=3

# Source 4: Crowdsource (live, free)
# When a user opens the WebApp from an Iranian-routed connection (resident
# or on an Iranian-exit VPN), their real WebRTC + HTTP measurement is the
# highest-fidelity Iran-side signal we can collect. Stored in-memory only,
# expires after CROWD_MAX_AGE_S, hashed user IDs (no PII at rest).
CROWD_ENABLED=true
# ISO-2 country code that triggers ingest. "IR" is the obvious choice.
CROWD_COUNTRY=IR
# How long a sample stays in the rolling window (seconds). 1200 = 20 min.
CROWD_MAX_AGE_S=1200
# Max distinct samples kept per messenger before the oldest are evicted.
CROWD_MAX_PER_MESSENGER=30
# Per-(user, messenger) dedup window — newer sample replaces older within this.
CROWD_DEDUP_WINDOW_S=1200
# Min DISTINCT-user samples before crowdsource emits a verdict.
CROWD_MIN_SAMPLES=3
# Success-rate thresholds (0.0 – 1.0).
CROWD_SUCCESS_THRESHOLD=0.7
CROWD_BLOCKED_THRESHOLD=0.3

# PaaS (Back4app, etc.): health HTTP on 0.0.0.0:PORT; match Dockerfile EXPOSE.
# PORT=8080
# PINGLUMA_DISABLE_HTTP_HEALTH=1

DROP_PENDING=true
